# Keep the image build context clean and deterministic.
node_modules
dist
dist-ssr
.output
.nitro
.vinxi
.tanstack
.wrangler
data
.git
.vscode
*.log
*.local

# Never bake local env files into images — configuration comes from build args
# and container environment (deploy/.env).
.env
.env.*
!.env.example
deploy/.env
deploy/.env.*
!deploy/.env.example
