# Hoard homelab deployment — copy to .env next to docker-compose.yml.

# Image tag to run (a version tag like v1.0.0, a sha-XXXXXXX tag, or latest).
#HOARD_TAG=latest

# ------------------------------------------------------------------ domains --
# Public hostname of the app. Caddy provisions HTTPS automatically, so this
# must be a DNS name resolving to this host. For LAN-only setups a local DNS
# entry (Pi-hole/AdGuard/router) + Caddy's internal CA works too — see README.
DOMAIN=hoard.example.com

# Hostname of the Jazz sync server (second DNS record, may CNAME to DOMAIN).
# Defaults to sync.<DOMAIN> if unset.
#SYNC_DOMAIN=sync.hoard.example.com

# Full public origins, derived from the domains by default. Only override for
# non-standard setups (e.g. plain-HTTP testing: http://192.168.1.10:8080).
#APP_ORIGIN=https://hoard.example.com
#SYNC_ORIGIN=https://sync.hoard.example.com

# --------------------------------------------------------------------- jazz --
# App ID namespacing your data on the sync server. MUST be a UUID —
# generate one with:  uuidgen | tr 'A-Z' 'a-z'
# Applied to the client bundle at container start (no rebuild needed), but
# changing it later means starting from an empty data namespace.
JAZZ_APP_ID=

# Admin secret for the Jazz server (needed by the `publish` service).
# Generate:  openssl rand -hex 32
JAZZ_ADMIN_SECRET=

# --------------------------------------------------------------------- auth --
# Secret Better Auth uses to sign/encrypt sessions. Generate:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# ------------------------------------------------------- AI enrichment (opt) --
# Optional AI capture enrichment (/api/enrich). Leave empty to disable.
#AI_PROVIDER=anthropic
#AI_MODEL=claude-haiku-4-5
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# -------------------------------------------------------------------- caddy --
# Host ports Caddy publishes. Leave at 80/443 in production.
#CADDY_HTTP_PORT=80
#CADDY_HTTPS_PORT=443
