# Hoard production deployment — copy to deploy/.env and fill in.
# docker compose reads this file automatically (it sits next to
# docker-compose.yml).

# ------------------------------------------------------------------ domains --
# Public hostname of the app. Caddy provisions HTTPS automatically, so this
# must be a real DNS name pointing at this host (A/AAAA record).
DOMAIN=hoard.example.com

# Hostname of the Jazz sync server (second A/AAAA record or CNAME to DOMAIN).
# Defaults to sync.<DOMAIN> if unset.
#SYNC_DOMAIN=sync.hoard.example.com

# Full public origins, derived from the domains by default. Only override for
# non-standard setups (e.g. plain-HTTP local testing: http://localhost:8080).
# APP_ORIGIN is what Better Auth uses as its base URL; SYNC_ORIGIN is baked
# into the client bundle as VITE_JAZZ_SERVER_URL at image build time.
#APP_ORIGIN=https://hoard.example.com
#SYNC_ORIGIN=https://sync.hoard.example.com

# --------------------------------------------------------------------- jazz --
# App ID namespacing your data on the sync server. MUST be a UUID — generate
# one with:  uuidgen | tr "A-Z" "a-z"
# Baked into the client bundle at build time; changing it means rebuilding the
# app image AND starting from an empty namespace.
JAZZ_APP_ID=

# Admin secret for the Jazz server. Required to publish schema/permissions
# (`jazz-tools deploy`). Generate:  openssl rand -hex 32
JAZZ_ADMIN_SECRET=

# --------------------------------------------------------------------- auth --
# Secret Better Auth uses to sign/encrypt sessions. Generate:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# ------------------------------------------------------- AI enrichment (opt) --
# Optional AI capture enrichment (/api/enrich). Leave empty to disable —
# the app works fully without it.
#AI_PROVIDER=anthropic
#AI_MODEL=claude-haiku-4-5
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# -------------------------------------------------------------------- caddy --
# Host ports Caddy publishes. Leave at 80/443 in production.
#CADDY_HTTP_PORT=80
#CADDY_HTTPS_PORT=443
