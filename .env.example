# Jazz app id — written automatically by the dev plugin on first run
VITE_JAZZ_APP_ID=

# Better Auth
BETTER_AUTH_SECRET=          # openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:4300

# Optional: AI capture enrichment (photo -> suggested name/description/keywords).
# The app works fine without it — enrichment UI simply stays hidden.
# AI_PROVIDER=anthropic      # 'anthropic' (default) or 'openai'
# AI_MODEL=claude-haiku-4-5  # default per provider (openai default: gpt-4o-mini)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Extra origins allowed to hit the auth API (comma-separated), e.g. for
# testing from a phone on your LAN:
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.20:4300
