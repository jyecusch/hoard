{
  "name": "hoard-scaffold",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 4300 --strictPort",
    "generate-routes": "tsr generate",
    "build": "vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
